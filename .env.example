# AskMyMD — copy this file to .env and fill in your own values
# Never commit the real .env file (it's gitignored)

# --- Backend (FastAPI) ---
# Required: Groq API key for LLM calls (summary + chat)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required: Postgres connection string (pgvector)
# Local example: postgresql://postgres:1234@localhost:5432/askmymd
# See backend/.env.example for full docs (Supabase, sslmode, pgvector)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/askmymd

# Optional: override if backend runs on a different host/port
# VITE_API_URL is read by the frontend at build time
# Default backend URL is http://localhost:8000, frontend dev server is http://localhost:5173
VITE_API_URL=http://localhost:8000

# Example for production / deployment:
# GROQ_API_KEY=gsk_...
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# VITE_API_URL=https://api.yourdomain.com

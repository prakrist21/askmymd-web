# ── Environment & secrets ─────────────────────
# Never commit real secrets — use .env.example as template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Allow example files (both root and backend/)
!.env.example
!**/.env.example


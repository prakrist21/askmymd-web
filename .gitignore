node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.pnp/
.pnp.js

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.conda/

# ── Build & cache ─────────────────────────────
dist/
build/
*.local
.vite/
.coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

[TEMPLATE]
# AskmyMD backend environment variables
GROQ_API_KEY=your_groq_api_key_here

# Postgres connection — LOCAL Postgres is the current standard; Supabase is the alternative.
#
# Local (recommended for dev):
#   postgresql://<user>:<password>@localhost:5432/<dbname>
#   e.g. postgresql://postgres:your_password@localhost:5432/askmymd
#   Create the DB once:  createdb -U postgres askmymd
#   (or: psql -U postgres -c "CREATE DATABASE askmymd;")
#   Notes:
#   - No `+psycopg` suffix needed: backend/app/database.py normalizes
#     postgresql:// → postgresql+psycopg:// automatically.
#   - No sslmode needed locally.
#   - URL-encode special characters in the password (@ → %40, # → %23, : → %3A).
#
# Supabase (alternative — hosted):
#   Use the Session pooler URI from Dashboard → Settings → Database →
#   Connection string → URI → Session (port 5432, NOT 6543):
#   postgresql://postgres.<PROJECT_REF>:<PASS_ENCODED>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#   database.py auto-appends sslmode=require for *.supabase.co hosts and
#   disables prepared statements only when pgbouncer=true is detected.
#
# pgvector: run once per database: CREATE EXTENSION IF NOT EXISTS vector;
# (also handled automatically on startup by the lifespan in backend/app/main.py)
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/askmymd

# Frontend — build-time API URL (Vite)
# Default backend URL is http://localhost:8000, frontend dev server is http://localhost:5173
VITE_API_URL=http://localhost:8000

# Tests use a separate DB — backend/tests/conftest.py defaults to local askmymd_test.
# Only set this to override (e.g. a hosted test project):
# TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/askmymd_test

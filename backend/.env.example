# AskmyMD backend environment variables
GROQ_API_KEY=your_groq_api_key_here
# Postgres connection — local dev and Neon both use this single variable.
# Local example: postgresql://postgres:1234@localhost:5432/askmymd
# Neon example:    postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Once per database, run: CREATE EXTENSION IF NOT EXISTS vector; (also handled automatically
# by the app startup lifespan in backend/app/main.py via _ensure_extension_and_tables())
DATABASE_URL=postgresql://user:pass@host:port/dbname
